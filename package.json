{
  "name": "jev-typecheckers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typecheckers: vanilla American checkers against Jev, with Discord, authoritative replays and detailed analytics",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "bench": "node --env-file-if-exists=.env bench/run.mjs",
    "verify": "node scripts/verify-replay.mjs",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply checkers --local",
    "db:remote": "wrangler d1 migrations apply checkers --remote",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.mjs",
    "analyze": "node scripts/analyze-replay.mjs",
    "deploy:godaddy": "node --env-file-if-exists=.env scripts/godaddy-deploy.js"
  },
  "devDependencies": {}
}
